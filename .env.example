# Banco (docker compose up -d db sobe um Postgres local nesta porta)
DATABASE_URL="postgresql://pulso:pulso@localhost:5434/pulso?schema=public"

# Sessão: gere com `openssl rand -base64 32`
AUTH_SECRET="troque-por-um-valor-aleatorio-com-32-caracteres-ou-mais"

# Segredo compartilhado entre o app e o n8n (chama /api/automation/tick)
AUTOMATION_SECRET="troque-por-outro-valor-aleatorio"

# Segredo HMAC do webhook de entrada (respostas dos leads)
WEBHOOK_SECRET="troque-por-mais-um-valor-aleatorio"

# Provedor de mensagens: simulated (padrão) ou whatsapp-cloud
MESSAGE_PROVIDER="simulated"

# Só usados com MESSAGE_PROVIDER=whatsapp-cloud (API oficial). Não versionar valores reais.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
# Segredo do app Meta (Configurações do app > Básico): confere a assinatura X-Hub-Signature-256 das respostas.
WHATSAPP_APP_SECRET=""
# Texto que você mesmo inventa e cola na Meta ao cadastrar o webhook (URL: /api/webhooks/whatsapp-cloud).
WHATSAPP_VERIFY_TOKEN=""

# Mostra a caixa de contas de teste na tela de login (versão de demonstração)
NEXT_PUBLIC_DEMO_ACCOUNTS="false"

# Só para o n8n do docker-compose (perfil n8n). URL pública do app publicado; vazio = app local na porta 3000.
PULSO_APP_URL=""
# Versão fixa do n8n (ex.: 1.x.y), depois de validar o fluxo. Vazio = a mais recente.
N8N_VERSION=""
